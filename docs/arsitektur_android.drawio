        <!-- Central Repositories -->
        <mxCell id="REPO_MAIN" value="Repositories: SupplierRepository • DocumentRepository • AuthRepository" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#FFFFFF;fontStyle=1;shadow=1;" vertex="1" parent="LANE_DATA">
