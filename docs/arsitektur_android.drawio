        </mxCell>
        <!-- Local Data Source -->
        <mxCell id="SRC_LOCAL" value="LOCAL DATA SOURCE (Room DB &amp; Storage)&#xa;• CachedSuppliersDao (Offline Directory)&#xa;• OfflineDocumentsDao (Metadata PDF)&#xa;• ScanHistoryDao (Riwayat QR Scan)&#xa;• Encrypted DataStore (Token Sesi User)&#xa;• Internal Storage (/data/data/.../pdf_cache)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0369A1;fontStyle=1;align=left;spacingLeft=15;shadow=1;" vertex="1" parent="LANE_DATA">
          <mxGeometry x="50" y="105" width="550" height="140" as="geometry" />
        </mxCell>
        <!-- Remote Data Source -->
        <mxCell id="SRC_REMOTE" value="REMOTE DATA SOURCE (Network API Client)&#xa;• Retrofit 2 &amp; OkHttp Client&#xa;• AuthInterceptor (Bearer Token Injection)&#xa;• Moshi / Kotlinx Serialization (JSON Parsing)&#xa;• Gating Error Handler (403 Forbidden Paywall)&#xa;• Endpoints: /api/v1/suppliers, /api/v1/documents" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#065F46;fontStyle=1;align=left;spacingLeft=15;shadow=1;" vertex="1" parent="LANE_DATA">
