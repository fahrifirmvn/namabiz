        <!-- FOOTER CATATAN -->
        <mxCell id="FOOTER_NOTE" value="&lt;b&gt;Catatan Arsitektur Android:&lt;/b&gt; Menerapkan pola &lt;b&gt;MVVM + Repository Pattern + Offline-First&lt;/b&gt; standar Google Android. Aplikasi mengutamakan pembacaan data lokal via &lt;b&gt;Room DB&lt;/b&gt; agar brosur tetap bisa dibuka tanpa sinyal (di pameran), dan sinkronisasi ke cloud via &lt;b&gt;Retrofit HTTP&lt;/b&gt; saat internet aktif." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1E40AF;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="895" width="1420" height="50" as="geometry" />
