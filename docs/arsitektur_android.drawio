        <!-- JUDUL UTAMA -->
        <mxCell id="TITLE_BAR" value="DIAGRAM ARSITEKTUR APLIKASI ANDROID (MVVM &amp; OFFLINE-FIRST) - SUPPLYCHAIN PRO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#FFFFFF;arcSize=8;shadow=1;" vertex="1" parent="1">
