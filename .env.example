APP_NAME=Namabiz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Reverse proxy IP/subnet (contoh Nginx lokal: 127.0.0.1,::1 atau Cloudflare/LB: *)
TRUSTED_PROXIES=127.0.0.1,::1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Gunakan user DB khusus aplikasi dengan hak minimum (SELECT, INSERT, UPDATE, DELETE) di runtime; jangan gunakan superuser/root
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=namabiz
# DB_USERNAME=namabiz_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true di environment HTTPS/production
SESSION_SECURE_COOKIE=false

SANCTUM_TOKEN_EXPIRATION=43200
GOOGLE_CLIENT_IDS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@namabiz.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Isi hanya dengan kanal yang sudah dikonfirmasi pemilik Namabiz.
NAMABIZ_CONTACT_EMAIL=
NAMABIZ_COMPANY_ADDRESS=
NAMABIZ_INSTAGRAM_URL=
NAMABIZ_LINKEDIN_URL=
# WhatsApp hanya tampil jika sumbernya adalah halaman portal resmi Namabiz.
NAMABIZ_CURATOR_WHATSAPP=
NAMABIZ_CURATOR_WHATSAPP_SOURCE=
